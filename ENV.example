# ==============================================================================
# TURNOFLOW AI — VARIABLES DE ENTORNO
# Copiá este archivo a `.env` o configurá las variables en tu servidor / hosting.
# NUNCA compartas claves privadas ni las expongas en el cliente.
# ==============================================================================

# Entorno general
NODE_ENV=development
EXPO_PUBLIC_APP_URL=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_PRODUCTION_API_URL=https://turnoflow-api.vercel.app
EXPO_PUBLIC_DASHBOARD_URL=https://turnoflow-product-clientturnoflow-p.vercel.app

# ------------------------------------------------------------------------------
# PROVEEDOR DE IA DEL ASISTENTE COMERCIAL (Servidor)
# Opciones disponibles: 'mock', 'anthropic', 'openai'
# ------------------------------------------------------------------------------
EXPO_PUBLIC_AI_PROVIDER=mock
EXPO_PUBLIC_AI_MODEL=claude-3-5-sonnet-20241022

# Claves de servidor (Solo backend / NUNCA expuestas al cliente)
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...

# ------------------------------------------------------------------------------
# PASARELAS DE PAGO (Servidor)
# Opciones disponibles: 'sandbox', 'stripe', 'mercadopago', 'lemonsqueezy'
# ------------------------------------------------------------------------------
EXPO_PUBLIC_PAYMENT_GATEWAY=sandbox
EXPO_PUBLIC_PAYMENT_SANDBOX=true

# Stripe (Servidor)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Mercado Pago (Servidor)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# Lemon Squeezy (Servidor)
LEMON_SQUEEZY_API_KEY=eyJ...
LEMON_SQUEEZY_WEBHOOK_SECRET=your_webhook_secret_here

# ------------------------------------------------------------------------------
# ANALÍTICA Y PÍXELES (Opcional - Públicos para el navegador)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_META_PIXEL_ID=
EXPO_PUBLIC_GA_MEASUREMENT_ID=
